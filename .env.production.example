# ====================================================================
# CellsInbox: Production Environment Configuration
# Copy this file to .env.production and set your secure secrets.
# ====================================================================

NODE_ENV=production

# --------------------------------------------------------------------
# 1. Database Configuration
# --------------------------------------------------------------------
# When running via docker-compose:
MONGODB_URI=mongodb://mongodb:27017/cellsinbox
MONGODB_DB_NAME=cellsinbox

# --------------------------------------------------------------------
# 2. Cryptographic Security Secrets (Min 32 characters)
# --------------------------------------------------------------------
JWT_SECRET=replace_with_a_cryptographically_secure_random_string_of_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_cryptographically_secure_random_string_32_chars

# --------------------------------------------------------------------
# 3. SMTP Inbound Port 25 Daemon & TLS Settings
# --------------------------------------------------------------------
SMTP_HOST=0.0.0.0
SMTP_PORT=25
MAIL_HELO_HOST=mail.yourdomain.com
SMTP_TLS_KEY_PATH=/etc/letsencrypt/live/mail.yourdomain.com/privkey.pem
SMTP_TLS_CERT_PATH=/etc/letsencrypt/live/mail.yourdomain.com/fullchain.pem

# --------------------------------------------------------------------
# 4. CellsWeb RPC API & WebSockets
# --------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4000
API_DOCS_ENABLED=false
API_LOG_LEVEL=info

# --------------------------------------------------------------------
# 5. Outbound MTA Queue Settings
# --------------------------------------------------------------------
QUEUE_POLL_INTERVAL_MS=3000

# --------------------------------------------------------------------
# 6. Web Application & Public Endpoints
# --------------------------------------------------------------------
FRONTEND_URL=https://mail.yourdomain.com
NEXT_PUBLIC_API_URL=https://mail.yourdomain.com/api
NEXT_PUBLIC_WS_URL=wss://mail.yourdomain.com/ws
