# Database
MONGODB_URI=mongodb://127.0.0.1:27017/cellsinbox
MONGODB_DB_NAME=cellsinbox

# Security & Secrets
JWT_SECRET=super_secure_jwt_secret_with_minimum_32_characters_here
JWT_REFRESH_SECRET=super_secure_jwt_refresh_secret_with_32_chars_here

# SMTP Inbound Server
SMTP_HOST=0.0.0.0
SMTP_PORT=2525
MAIL_HELO_HOST=mail.cells.local

# API Server
API_HOST=0.0.0.0
API_PORT=4000
API_DOCS_ENABLED=true
API_LOG_LEVEL=info

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Queue
QUEUE_POLL_INTERVAL_MS=5000
